/* ===== TABS-STATS · point-cloud morph tabs — paste into Webflow head ===== */
/* JS injects <canvas .tabs-stats_pointcloud> + adds .is-canvas once sampled. Hooks → tabs-stats.md. */

/* — Stage (stacked source images + injected canvas) — */
[data-component='tabs-stats'] .tabs-stats_tabs-content {
  position: relative;
  display: grid;
}

/* Source images stack in one cell; the active one shows (fallback) + reserves stage height. */
[data-component='tabs-stats'] .tabs-stats_tab-item {
  grid-area: 1 / 1;
  opacity: 0;
  transition: opacity 0.3s ease;
}
[data-component='tabs-stats'] .tabs-stats_tab-item.is-active {
  opacity: 1;
}

/* — Canvas mode (cloud owns the stage; images hidden but keep their layout height) — */
[data-component='tabs-stats'].is-canvas .tabs-stats_tab-item {
  opacity: 0;
  visibility: hidden;
}

[data-component='tabs-stats'] .tabs-stats_pointcloud {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
[data-component='tabs-stats'].is-canvas .tabs-stats_pointcloud {
  pointer-events: auto; /* hover nebula needs the cursor over the canvas */
}

/* — Gold glow behind the cloud (optional; delete if Webflow provides one) — */
[data-component='tabs-stats'].is-canvas .tabs-stats_tabs-content::before {
  content: '';
  position: absolute;
  inset: 10% 0 0;
  z-index: 0;
  pointer-events: none;
  background: radial-gradient(
    ellipse 60% 55% at 50% 78%,
    rgba(226, 188, 110, 0.42),
    rgba(226, 188, 110, 0) 70%
  );
}

/* — Progress underline / track / fill (grey track = remaining, black fill = progress) — */
[data-component='tabs-stats'] {
  --tabs-track-active: #b3aea2; /* state 2 — a darker shade of --base--grey-line */
}
[data-component='tabs-stats'] .tabs-architected_tab-link-underline {
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
}
[data-component='tabs-stats'] .tabs-architected_tab-link-underline.is-track {
  transform: none;
  background-color: var(--base--grey-line, #e4e2dd);
  transition: background-color 0.4s ease;
}
[data-component='tabs-stats']
  [tabs-architected='link'].is-active
  .tabs-architected_tab-link-underline.is-track {
  background-color: var(--tabs-track-active, #b3aea2);
}
[data-component='tabs-stats'] .tabs-architected_tab-link-fill {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
  background-color: var(--base--black, #000);
}

/* — Reduced motion (no canvas/fill): show the active underline itself, black + full. — */
@media (prefers-reduced-motion: reduce) {
  [data-component='tabs-stats']
    [tabs-architected='link'].is-active
    .tabs-architected_tab-link-underline {
    transform: scaleX(1);
    background-color: var(--base--black, #000);
  }
}

/* ============================================================
   LOGO WALL — visible count per breakpoint
   ============================================================ */

/* Show 8 on desktop, 6 on mobile */
[data-logo-wall-list] [data-logo-wall-item]:nth-child(n + 9) {
  display: none;
}

/* logo-wall — testimonial reveal on hover. Paste into Webflow global head.
   Layout, sizing and the logo roll are handled by Webflow's own logo-wall
   classes — this ONLY adds the per-logo testimonial (the JS toggles the classes).
   Don't add layout rules here; they fight Webflow's and collapse the slot. */

[data-component='logo-wall'] {
  --logo-wall-fade: 0.4s; /* testimonial show/hide transition */
  --logo-wall-blur: 12px; /* testimonial de-blur start amount */
}

/* Positioning context for the testimonial overlay. */
[data-component='logo-wall'] .logo-wall__logo {
  position: relative;
}

/* Testimonial overlay — hidden until JS adds .is-visible
   (overrides the display:none / opacity:0 set in Webflow). */
[data-component='logo-wall'] .logo-wall_testimonial {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  /* De-blur reveal: starts blurred + slightly faded, sharpens on hover. */
  filter: blur(var(--logo-wall-blur));
  transition:
    opacity var(--logo-wall-fade) ease,
    filter var(--logo-wall-fade) ease,
    visibility var(--logo-wall-fade) ease;
}

[data-component='logo-wall'] .logo-wall_testimonial.is-visible {
  opacity: 1;
  visibility: visible;
  filter: blur(0);
}

/* Keep the large testimonial image inside its slot. */
[data-component='logo-wall'] .logo-wall_testimonial-image {
  max-width: 100%;
  height: auto;
}

/* Hide the logo while its testimonial shows. */
[data-component='logo-wall']
  .logo-wall__logo.is-showing-testimonial
  [data-logo-wall-target] {
  opacity: 0;
  visibility: hidden;
}

/* Keyboard focus ring. */
[data-component='logo-wall'] .logo-wall__logo:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 4px;
}

/* Reduced motion: no fade, no de-blur. */
@media (prefers-reduced-motion: reduce) {
  [data-component='logo-wall'] .logo-wall_testimonial {
    filter: none;
    transition: none;
  }
}

/* ============================================================
   SCROLL MORPH — in-view point-cloud reveal
   ============================================================ */
/* NOT bundled: paste into Webflow → Project Settings → Custom Code → Head.
   Holds only what the Designer can't express. Designer settings → scroll-morph.md. */

[data-component='scroll-morph'] {
  --scroll-morph-top-safe: 0rem; /* nav clearance — used by the track + messages */
}

/* Stage geometry (in-flow, no pin/sticky). The track is a normal full-viewport box
   holding the canvas + centred text; overflow:hidden clips them to the section. */
[data-component='scroll-morph'].is-canvas [data-scroll-morph-track] {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

/* Off-screen: hide the (still-revealed) messages so they don't bleed into other sections. */
[data-component='scroll-morph'].is-offscreen [data-scroll-morph-messages] {
  visibility: hidden;
}

/* The canvas is injected by JS into the stage — it doesn't exist in the Designer. */
.scroll-morph_canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* grid + grid-area stacks every message in one cell; pointer-events:none lets the
   hover reach the cloud stage underneath. */
[data-scroll-morph-messages] {
  position: absolute;
  inset: var(--scroll-morph-top-safe) 0 0;
  z-index: 1;
  display: grid;
  place-items: center;
  padding: 1.5rem; /* breathing room so the text never touches the viewport edges */
  pointer-events: none;
}

[data-scroll-morph-message] {
  grid-area: 1 / 1; /* stack all messages in one cell */
}

/* Word spans are styled inline from JS (display:inline-block + will-change). */

/* Anti-FOUC gate (lifted by JS via .is-ready; reduced-motion never gated). */
html.js-anim [data-component='scroll-morph'] {
  opacity: 0;
}
html.js-anim [data-component='scroll-morph'].is-ready {
  opacity: 1;
}

/* Static fallback (reduced motion / no canvas): readable vertical layout. */
[data-component='scroll-morph']:not(.is-canvas) [data-scroll-morph-track] {
  min-height: 0;
  overflow: visible;
}
[data-component='scroll-morph']:not(.is-canvas) [data-scroll-morph-messages] {
  position: static;
  display: block;
  padding: 4rem 1.5rem;
}
[data-component='scroll-morph']:not(.is-canvas) [data-scroll-morph-message] {
  grid-area: auto;
  margin: 0 auto 3rem;
}

/* ===== SHARE · "Copied!" tooltip — paste into Webflow head ===== */
/* Only the injected tooltip lives here. Buttons/layout are styled in Webflow.
   Hooks → .claude/rules/components/share.md */

/* Anchor for the absolutely-positioned tooltip. */
[data-component='blog-post'] [data-share='copy'] {
  position: relative;
}

/* — Injected default tooltip (.share_tooltip) — */
[data-component='blog-post'] .share_tooltip {
  position: absolute;
  bottom: calc(100% + 0.5rem); /* sits above the button */
  left: 50%;
  z-index: 10;
  padding: 0.375rem 0.625rem;
  border-radius: 0.375rem;
  background: var(--base--black, #000);
  color: #fff;
  font-size: 0.75rem;
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, 0.25rem);
  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

/* Little arrow under the tooltip. */
[data-component='blog-post'] .share_tooltip::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  border: 5px solid transparent;
  border-top-color: var(--base--black, #000);
  transform: translateX(-50%);
}

/* Shown state (JS toggles .is-visible). */
[data-component='blog-post'] .share_tooltip.is-visible {
  opacity: 1;
  transform: translate(-50%, 0);
}

@media (prefers-reduced-motion: reduce) {
  [data-component='blog-post'] .share_tooltip {
    transition: none;
  }
}

/* ===== REFERENCES · citation cross-linking — paste into Webflow head ===== */
/* Styles the JS-injected pieces (badge, back-link, cite anchors, active highlight).
   The reference text + layout and the View/PubMed/Scholar link looks are free in the
   Designer (target .is-view / .is-pubmed / .is-scholar). Hooks → .claude/rules/components/references.md */

/* — In-body citation markers (the <sup> numbers, now anchors) — */
[data-references-body] .references_cite {
  color: var(--base--gold, #c79a4b);
  text-decoration: none;
  cursor: pointer;
  scroll-margin-top: 6rem; /* clear the fixed nav when jumped to */
}
[data-references-body] .references_cite:hover {
  text-decoration: underline;
}

/* Gold 30% highlight: on the word before the marker (back to citation) and on the
   reference itself (jump to reference). */
[data-references-body] .references_cited-word.is-active,
[data-component='blog-post'] .references_item.is-active {
  background-color: rgba(199, 154, 75, 0.3);
  border-radius: 0.25rem;
  transition: background-color 0.3s ease;
}

/* — Reference list items (number column + content column, each separated by a bottom line) — */
[data-component='blog-post'] .references_item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
  padding-bottom: 1.75rem;
  margin-bottom: 1.75rem;
  border-bottom: 1px solid var(--base--grey-line, #d9d4c9);
  scroll-margin-top: 6rem;
  outline: none;
}
[data-component='blog-post'] .references_item:last-child {
  border-bottom: none;
}
[data-component='blog-post'] .references_content {
  flex: 1 1 auto;
  min-width: 0;
}

/* Author-typed leading number, wrapped by JS — plain left column, aligned to the first line.
   Resets background/border so no circle "badge" (from Designer styling) survives; min-width
   fits up to 3-digit numbers without shifting the text column. */
[data-component='blog-post'] .references_number {
  flex: none;
  min-width: 1.75rem;
  padding: 0;
  background: none;
  border: none;
  border-radius: 0;
  color: var(--base--black, #1a1a1a);
  font-weight: 600;
  line-height: inherit;
  text-align: left;
}

/* — "Go to Citation" back-link (injected) — plain underlined text link under the reference,
   arrow after. Resets padding/background/border so no "pill" (from Designer styling) survives. */
[data-component='blog-post'] .references_backlink {
  display: block;
  width: fit-content;
  margin-top: 0.875rem;
  padding: 0;
  background: none;
  border: none;
  border-radius: 0;
  color: var(--base--black, #1a1a1a);
  text-decoration: underline;
  text-underline-offset: 0.2em;
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
}
[data-component='blog-post'] .references_backlink::after {
  content: '→';
  display: inline-block; /* atomic inline → the link underline skips the arrow */
  margin-left: 0.4em;
  text-decoration: none;
}
[data-component='blog-post'] .references_backlink[hidden] {
  display: none;
}

/* Author links are classified .is-view / .is-pubmed / .is-scholar — style them in the Designer. */

@media (prefers-reduced-motion: reduce) {
  [data-references-body] .references_cited-word.is-active,
  [data-component='blog-post'] .references_item.is-active {
    transition: none;
  }
}

/* ===== LIGHTBOX · article image figure viewer — paste into Webflow head ===== */
/* Only our custom UI lives here (clickable affordance + caption panel + custom buttons).
   PhotoSwipe's CORE css is loaded separately from the CDN <link> in the head — see the doc.
   Hooks → .claude/rules/components/lightbox.md */

/* Sit above any fixed page chrome (TOC, social rail, citation back-links). */
.pswp {
  z-index: 200000;
}

/* Clickable affordance on article images. */
[data-component='blog-post'] .lightbox_img {
  cursor: zoom-in;
}
[data-component='blog-post'] .lightbox_img:focus-visible {
  outline: 2px solid var(--base--gold, #c79a4b);
  outline-offset: 3px;
}

/* — Inline caption (top bar, beside the icons) — */
.pswp__caption-bar {
  display: flex;
  align-items: center;
  max-width: min(46vw, 620px);
  height: 100%;
  margin-right: 0.5rem;
  padding: 0 0.375rem;
  color: #f2f2f2;
  font-size: 0.875rem;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  opacity: 0.9;
}
.pswp__caption-bar.is-empty {
  display: none;
}
@media (max-width: 767px) {
  .pswp__caption-bar {
    max-width: 42vw;
    font-size: 0.8125rem;
  }
}

/* — Custom buttons — SVG glyph, centered, with a subtle rounded hover. */
.pswp__button--download,
.pswp__button--share {
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}
.pswp__button--download svg,
.pswp__button--share svg {
  display: block;
}
.pswp__top-bar .pswp__button {
  border-radius: 8px;
  transition:
    background-color 0.2s ease,
    opacity 0.2s ease;
}
.pswp__top-bar .pswp__button:hover {
  background: rgba(255, 255, 255, 0.14);
}

/* ===== TOC · article table of contents (accordion + scrollspy) — paste into Webflow head ===== */
/* Self-contained — the component injects its own toc_* markup (decoupled from the
   Finsweet/Relume content27 template), so the whole TOC look lives here. The label keeps
   the global .text-size-regular class for type sizing.
   Hooks → .claude/rules/components/toc.md */

/* — List — */
[data-component='blog-post'] .toc_item {
  display: block;
}

/* — Links (left rail + active indicator) — */
[data-component='blog-post'] .toc_link {
  display: block;
  padding: 0.4rem 0 0.4rem 1rem;
  border-left: 2px solid var(--base--grey-line, #e4e2dc);
  color: var(--base--grey, #8a8f98);
  text-decoration: none;
  line-height: 1.35;
  transition:
    color 0.2s ease,
    border-color 0.2s ease;
}
[data-component='blog-post'] .toc_link:hover {
  color: var(--base--black, #15110c);
}
[data-component='blog-post'] .toc_link.current {
  color: var(--base--black, #15110c);
  border-left-color: var(--base--black, #15110c);
}

/* Indent per heading level (H3/H4 nested under their H2/H3). */
[data-component='blog-post'] .toc_item.is-h3 > .toc_link {
  padding-left: 2rem;
}
[data-component='blog-post'] .toc_item.is-h4 > .toc_link {
  padding-left: 3rem;
}

/* — Accordion — */
/* Collapsible branch the scrollspy opens/closes (GSAP animates its height). */
[data-component='blog-post'] .toc_children {
  overflow: hidden;
}

/* — Scroll target clearance — */
/* Native anchor jumps (mobile / reduced-motion) land below the fixed nav.
   Desktop smooth scroll already offsets via the global Lenis bridge. */
[data-component='blog-post'] [data-toc-target] {
  scroll-margin-top: 6rem;
}

/* ===== TABLE-COLLAPSE · long article tables → show more/less — paste into Webflow head ===== */
/* The component wraps each long <table> in .table-collapse_wrap (clips to the fold),
   overlays a fade, and injects a .table-collapse_toggle button. Height is animated by GSAP.
   Hooks → .claude/rules/components/table-collapse.md */

/* — Clipping wrapper (JS sets max-height to the fold) — */
.table-collapse_wrap {
  position: relative;
  overflow: hidden;
}

/* — Fade over the clipped rows (only while collapsed) — */
.table-collapse_fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 5rem;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0),
    var(--base--white, #fff)
  );
}
.table-collapse_wrap.is-collapsed .table-collapse_fade {
  opacity: 1;
}

/* — Toggle button — */
.table-collapse_toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
  padding: 0.5rem 1.25rem;
  font: inherit;
  font-size: 0.875rem;
  line-height: 1;
  color: var(--base--black, #15110c);
  background: transparent;
  border: 1px solid var(--base--grey-line, #e4e2dc);
  border-radius: 8px;
  cursor: pointer;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease;
}
.table-collapse_toggle:hover {
  border-color: var(--base--black, #15110c);
  background: var(--base--grey-line, #e4e2dc);
}
.table-collapse_toggle:focus-visible {
  outline: 2px solid var(--base--black, #15110c);
  outline-offset: 2px;
}

/* Caret — points down (show more), flips up when expanded (show less). */
.table-collapse_toggle::after {
  content: '';
  width: 0.5rem;
  height: 0.5rem;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: translateY(-2px) rotate(45deg);
  transition: transform 0.2s ease;
}
.table-collapse_toggle[aria-expanded='true']::after {
  transform: translateY(1px) rotate(-135deg);
}

/* ===== FIGURES · caption beside the image (blog-post) — paste into Webflow head ===== */

/* Each figure + its caption block are wrapped in .figure-aside by figures.js */
[data-component='blog-post'] .figure-aside {
  display: flex;
  align-items: flex-start;
  gap: 1.5rem;
  margin: 1.5rem 0;
}

[data-component='blog-post'] .figure-aside > figure {
  flex: 0 0 60%;
  margin: 0;
}

[data-component='blog-post'] .figure-aside > .w-embed {
  flex: 1 1 auto;
  min-width: 0;
}

/* — Stack below the image on tablet and down — */
@media (max-width: 767px) {
  [data-component='blog-post'] .figure-aside {
    flex-direction: column;
    gap: 0.5rem;
  }
  [data-component='blog-post'] .figure-aside > figure {
    flex-basis: auto;
    width: 100%;
  }
}

/* ===== RESEARCH-SEARCH · matched-term highlight + clear-icon affordance — paste into Webflow head ===== */

/* — Matched-term highlight —
   research-search.js wraps each matched substring in the title in
   <mark class="search-highlight">. Gold @ 30% (matches references). */
.search-highlight {
  background-color: rgba(199, 154, 75, 0.3); /* --base--gold @ 30% */
  border-radius: 0.2em;
  padding: 0 0.08em;
  color: inherit;
}

/* — Clear-search icon —
   The header search icon [data-research-clear] is a passive magnifier until the
   input has text, when JS swaps in a ✕ and adds .is-clearable — then it's a button. */
[data-research-clear] {
  cursor: default;
  transition: opacity 0.2s ease;
}

[data-research-clear].is-clearable {
  cursor: pointer;
  pointer-events: auto;
}

[data-research-clear].is-clearable:hover {
  opacity: 0.6;
}


/* ===== IMPACT-MAP · animated US map: odometer % synced with a clustered gold-dot reveal — paste into Webflow head ===== */

[data-component='impact-map'] {
  /* — Tokens (Figma) — */
  --im-bg: #000000; /* frame fill: Black */
  --im-land: #333333; /* state fill: 333333 */
  --im-land-stroke: rgba(232, 226, 210, 0.4); /* state borders: Beige, weight 0.1 */
  --im-dot-glow: rgba(247, 201, 72, 0.5); /* dot drop shadow: gold @ 50% */
  --im-label: rgba(255, 255, 255, 0.3);
}

/* — Counter (value beside the caption) — */
[data-impact-counter] {
  font-weight: 800;
}

/* — Stage: reserves aspect-ratio so there is zero CLS while the SVG loads — */
[data-impact-stage] {
  position: relative;
  width: 100%;
  aspect-ratio: 960 / 600;
  background: var(--im-bg);
  border-radius: 0.75rem;
  overflow: hidden;
}
[data-impact-stage] svg {
  display: block;
  width: 100%;
  height: 100%;
}

/* — Map geometry — */
[data-impact-land] path {
  fill: var(--im-land);
  stroke: var(--im-land-stroke);
  stroke-width: 0.4;
  stroke-linejoin: round;
}

/* State initials, sitting behind the dots — */
[data-impact-labels] text {
  fill: var(--im-label);
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-anchor: middle;
  dominant-baseline: middle;
}

/* — Dots: each is a <g> (halo + core); GSAP fades the group in and twinkles it — */
[data-impact-dots] > g {
  opacity: 0;
  transition: filter 0.3s ease;
}
/* Soft bloom behind the dot — the Figma drop shadow, as a real radial.
   pointer-events:all makes the whole disc hoverable (even its transparent edge). */
[data-impact-dots] .im-halo {
  fill: url(#im-glow-grad);
  pointer-events: all;
}
/* Bright core: hot-white centre → gold, plus a tight glow for the spread. */
[data-impact-dots] .im-core {
  fill: url(#im-dot-grad);
  filter: drop-shadow(0 0 2px var(--im-dot-glow));
}
/* Hover: brighten the whole dot (glow + core) — CSS only, so it rides on top of
   the GSAP opacity twinkle without fighting it. */
[data-impact-dots] > g:hover {
  filter: brightness(1.7) saturate(1.12);
}

/* — Odometer (rolling digits) — */
.impact-map_odo {
  /* Cell taller than the glyph so the digit is centred by leading and never
     clips top/bottom; the reel advances by one cell (percentage) per digit. */
  --odo-h: 1.3em;
  display: inline-flex;
  align-items: baseline;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}
/* Slot keeps a real text baseline (via the invisible anchor) so the rolling
   digits line up with the comma, % and caption text. The clip — not the slot —
   hides the overflow, because an overflow:hidden inline-block reports its bottom
   edge as the baseline and floats the digits up. */
.impact-map_odo .odo-digit {
  position: relative;
  display: inline-block;
  width: 0.72em;
  height: var(--odo-h);
  line-height: var(--odo-h);
}
.impact-map_odo .odo-digit::before {
  content: '8';
  visibility: hidden;
}
.impact-map_odo .odo-clip {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.impact-map_odo .odo-reel {
  display: block;
  will-change: transform;
}
.impact-map_odo .odo-reel span {
  display: block;
  height: var(--odo-h);
  line-height: var(--odo-h);
  text-align: center;
}
.impact-map_odo .odo-sep {
  display: inline-block;
}

.impact-map_sronly {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* Reduced motion: no rolling / no fade — final state shown instantly (JS also guards). */
@media (prefers-reduced-motion: reduce) {
  .impact-map_odo .odo-reel {
    will-change: auto;
  }
}
