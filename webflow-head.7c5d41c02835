/* ============================================================
   WEBFLOW HEAD — global custom code (Project Settings → Custom Code → Head)
   ------------------------------------------------------------
   This is the COMBINED CSS pasted (inside a <style>) into Webflow's head.
   It mirrors what's live on the site. The per-component source files in
   src/components/styles/*.css are the canonical versions — keep this in sync
   when you edit a component (or regenerate it; see CONVENTIONS / FILE_STRUCTURE).

   ⚠ Paste this into Project Settings → Custom Code → HEAD (limit ~20,000 chars),
   NOT into an HTML Embed: an Embed caps at 10,000 chars and silently truncates,
   which breaks the whole <style> (every component, incl. buttons). If you must use
   embeds for canvas preview, split into chunks under 10k each.
   ============================================================ */

/* ===== BUTTON · primary + secondary variants — paste into Webflow head ===== */

/* — Tokens + base — */
.button_main-wrap {
  --anim-time: 0.35s;
  --anim-ease: cubic-bezier(0.4, 0, 0.2, 1);
  --btn-radius: 0.5rem;
  --btn-beam-width: 1.5px; /* rotating-beam ring thickness (secondary) */
  --btn-beam-speed: 6s; /* idle beam lap time; hover accel is JS (playbackRate) */
}

/* Rotating gold beam angle (secondary). @property makes --btn-angle animatable;
   inherits:true so the animation (on the element) reaches ::after which reads it.
   Hover acceleration is done in global.js via the Web Animations API (playbackRate)
   so speed changes preserve the current angle — no jump/reset. */
@property --btn-angle {
  syntax: '<angle>';
  initial-value: 0deg;
  inherits: true;
}
@keyframes buttonBeamSpin {
  to {
    --btn-angle: 360deg;
  }
}

.button_main-wrap .item-link:focus-visible {
  outline: 2px solid #fbd07c;
  outline-offset: 2px;
}

.button_main-element {
  isolation: isolate;
  border-radius: var(--btn-radius);
  transition:
    transform var(--anim-time) var(--anim-ease),
    background-color var(--anim-time) var(--anim-ease),
    box-shadow var(--anim-time) var(--anim-ease);
}

.button_main-text {
  white-space: nowrap;
}

/* — Icon nudge on hover — */
.button_main-icon {
  display: inline-flex;
  transition: transform var(--anim-time) var(--anim-ease);
}
.button_main-wrap:hover .button_main-icon {
  transform: translateX(0.12em);
}

/* — Primary (gradient fill + radial border, subtle gloss) — */
.button_main-wrap[data-wf--element-button--variant='primary']
  .button_main-element {
  color: #ffffff;
  background:
    linear-gradient(134deg, #000000 0%, #4e4e4e 40%) padding-box,
    radial-gradient(
        135% 180% at 50% 0%,
        #b8b8b8 0%,
        #9e9e9e 52%,
        rgba(0, 0, 0, 0.78) 100%
      )
      border-box;
}
.button_main-wrap[data-wf--element-button--variant='primary']
  .button_main-element::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  border-radius: inherit;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.08) 0%,
    rgba(255, 255, 255, 0) 45%
  );
  pointer-events: none;
}
.button_main-wrap[data-wf--element-button--variant='primary']:hover
  .button_main-element {
  transform: translateY(-1px);
  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.2),
    0 4px 10px rgba(0, 0, 0, 0.18);
}

/* — Secondary (light frosted glass, no border) —
   Plain secondary is borderless: just the frosted glass + a subtle background lift on
   hover. Add data-gradient-animation="True" on the wrap for the rotating gold-beam ring. */
.button_main-wrap[data-wf--element-button--variant*='secondary']
  .button_main-element {
  position: relative;
  color: #000000;
  background: rgba(114, 114, 114, 0.08);
  -webkit-backdrop-filter: blur(4px) saturate(115%);
  backdrop-filter: blur(4px) saturate(115%);
  border-color: transparent;
}
/* Gloss */
.button_main-wrap[data-wf--element-button--variant*='secondary']
  .button_main-element::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  border-radius: inherit;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.12) 0%,
    rgba(255, 255, 255, 0) 50%
  );
  pointer-events: none;
}
.button_main-wrap[data-wf--element-button--variant*='secondary']:hover
  .button_main-element {
  background: rgba(114, 114, 114, 0.14);
  transform: translateY(-1px);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.4),
    0 3px 8px rgba(0, 0, 0, 0.06);
}

/* — Secondary · rotating-beam variant (data-gradient-animation="True") — */
.button_main-wrap[data-wf--element-button--variant*='secondary'][data-gradient-animation='True']
  .button_main-element {
  /* Beam spin lives on the element (not ::after) so global.js can grab it via
     el.getAnimations() and only change playbackRate on hover — no position jump. */
  animation: buttonBeamSpin var(--btn-beam-speed) linear infinite;
}
/* Beam ring: two bright gold arcs ride the perimeter (opposite ends), masked to a thin
   ring. Only the animated variant has a gold ring — plain secondary has none. */
.button_main-wrap[data-wf--element-button--variant*='secondary'][data-gradient-animation='True']
  .button_main-element::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
  border-radius: inherit;
  padding: var(--btn-beam-width);
  background: conic-gradient(
    from var(--btn-angle, 0deg),
    rgba(199, 154, 75, 0) 0deg,
    /* beam 2 (opposite end) */
    rgba(199, 154, 75, 0) 120deg,
    rgba(199, 154, 75, 0.5) 150deg,
    var(--base--gold, #c79a4b) 170deg,
    #ffedb5 175deg,
    var(--base--gold, #c79a4b) 178deg,
    rgba(199, 154, 75, 0) 195deg,
    /* beam 1 */
    rgba(199, 154, 75, 0) 300deg,
    rgba(199, 154, 75, 0.5) 330deg,
    var(--base--gold, #c79a4b) 350deg,
    #ffedb5 355deg,
    var(--base--gold, #c79a4b) 358deg,
    rgba(199, 154, 75, 0) 360deg
  );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}
/* Hover acceleration: JS (global.js) bumps the spin's playbackRate — see @property note. */

/* — Reduced motion — */
@media (prefers-reduced-motion: reduce) {
  .button_main-element,
  .button_main-element::before,
  .button_main-element::after,
  .button_main-icon {
    transition: none !important;
  }
  /* No spin — the beam variant falls back to a static uniform gold ring */
  .button_main-wrap[data-wf--element-button--variant*='secondary'][data-gradient-animation='True']
    .button_main-element {
    animation: none;
  }
  .button_main-wrap[data-wf--element-button--variant*='secondary'][data-gradient-animation='True']
    .button_main-element::after {
    background: var(--base--gold, #c79a4b);
  }
}

/* ===== PARADIGM · autoplay tabs (underline progress) — paste into Webflow head ===== */

/* Root */
[data-component='paradigm'] {
  position: relative;
  overflow: hidden;
}

/* Clickable menu numbers (enhanced only): each jumps to its tab */
[data-component='paradigm'].is-enhanced [data-paradigm='tab-link'] {
  cursor: pointer;
}

/* Text messages (stacked, one shown at a time) */
[data-paradigm-messages] {
  display: grid;
}
[data-paradigm='tab-title'] {
  grid-area: 1 / 1;
}
.title-anim_word {
  display: inline-block;
  will-change: transform, filter, opacity;
}

/* Underline progress — light-grey track under all numbers + darker fill that grows
   left→right as the autoplay loads (JS scales it via scaleX) */
.tabs_number-underline {
  overflow: hidden;
  background: var(--base--grey-line, #e2e2e2);
}
.tabs_number-underline-fill {
  width: 100%;
  height: 100%;
  background: var(--base--black, #000);
  transform: scaleX(0);
  transform-origin: left center;
}

/* Visuals (stacked, crossfaded) */
.tabs-paradigm_visual-wrapper {
  display: grid;
}
[data-paradigm-visual] {
  grid-area: 1 / 1;
}

/* Fallback (no JS / reduced motion): show only the first / active tab */
[data-component='paradigm']:not(.is-enhanced) [data-paradigm='tab-title'],
[data-component='paradigm']:not(.is-enhanced) [data-paradigm-visual] {
  opacity: 0;
}
[data-component='paradigm']:not(.is-enhanced)
  [data-paradigm='tab-title']:first-child,
[data-component='paradigm']:not(.is-enhanced)
  [data-paradigm='tab-title'].is-active,
[data-component='paradigm']:not(.is-enhanced)
  [data-paradigm-visual]:first-child,
[data-component='paradigm']:not(.is-enhanced) [data-paradigm-visual].is-active {
  opacity: 1;
}

/* ===== COMPOUDING · paradigm-clone autoplay tabs (underline progress) — paste into Webflow head ===== */
/* Self-contained (scoped to the root) so it doesn't depend on the PARADIGM block. Hooks → compouding.md. */

[data-component='compouding'] {
  position: relative;
  overflow: hidden;
}

/* Clickable menu numbers (enhanced only): each jumps to its tab */
[data-component='compouding'].is-enhanced [data-paradigm='tab-link'] {
  cursor: pointer;
}

/* Text messages (stacked, one shown at a time) */
[data-component='compouding'] [data-paradigm-messages] {
  display: grid;
}
[data-component='compouding'] [data-compunding='tab-title'] {
  grid-area: 1 / 1;
}

/* Underline progress — light-grey track under all numbers + darker fill that grows
   left→right as the autoplay loads (JS scales it via scaleX) */
[data-component='compouding'] .tabs_number-underline {
  overflow: hidden;
  background: var(--base--grey-line, #e2e2e2);
}
[data-component='compouding'] .tabs_number-underline-fill {
  width: 100%;
  height: 100%;
  background: var(--base--black, #000);
  transform: scaleX(0);
  transform-origin: left center;
}

/* Visuals (stacked; crossfade fallback OR injected point-cloud canvas) */
[data-component='compouding'] .tabs-compouding_visual-wrapper {
  position: relative;
  display: grid;
}
[data-component='compouding'] [data-paradigm-visual] {
  grid-area: 1 / 1;
}
[data-component='compouding'].is-canvas [data-paradigm-visual] {
  visibility: hidden;
}
[data-component='compouding'] .tabs-compouding_pointcloud {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
[data-component='compouding'].is-canvas .tabs-compouding_pointcloud {
  pointer-events: auto;
}
[data-component='compouding'] [data-compouding-overlay] {
  z-index: 2;
  pointer-events: none;
}
/* Injected flow-tab tags — container fills the stage; JS sets each pill's left/top on the ring */
[data-component='compouding'] .tabs-compouding_tags {
  position: absolute;
  inset: 0;
}
[data-component='compouding'] .tabs-compouding_tag {
  position: absolute;
  transform: translate(-50%, -50%);
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1rem;
  border-radius: 999px;
  background: rgba(244, 243, 240, 0.82);
  backdrop-filter: blur(4px);
  font-weight: 600;
  white-space: nowrap;
  color: var(--base--black, #0a0a0a);
}

/* Fallback (no JS / reduced motion): show only the first / active tab */
[data-component='compouding']:not(.is-enhanced) [data-compunding='tab-title'],
[data-component='compouding']:not(.is-enhanced) [data-paradigm-visual] {
  opacity: 0;
}
[data-component='compouding']:not(.is-enhanced)
  [data-compunding='tab-title']:first-child,
[data-component='compouding']:not(.is-enhanced)
  [data-compunding='tab-title'].is-active,
[data-component='compouding']:not(.is-enhanced)
  [data-paradigm-visual]:first-child,
[data-component='compouding']:not(.is-enhanced)
  [data-paradigm-visual].is-active {
  opacity: 1;
}

/* ===== TABS-ARCHITECTED · autoplay tabs — paste into Webflow head ===== */
/* Only panel stacking + the underline/track baseline live here. Hooks → tabs-architected.md. */

/* — Panel stacking (grid: same cell, no CLS) — */
[data-component='tabs-architected'] .tabs-architected_tabs-content {
  display: grid;
}
[data-component='tabs-architected'] .tabs-architected_tab-item {
  grid-area: 1 / 1; /* every panel occupies the same grid cell */
}

/* — Image wipe baseline — */
[data-component='tabs-architected'] [tabs-architected='image'] {
  will-change: clip-path;
}

/* — Progress underline / track / fill (three states) — */
[data-component='tabs-architected'] {
  --tabs-track-active: #b3aea2; /* state 2 — a darker shade of --base--grey-line */
}

/* Baseline: collapsed (no flash). Also the reduced-motion bar (underline itself). */
[data-component='tabs-architected'] .tabs-architected_tab-link-underline {
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
}

/* State 1 — grey track on every tab (full width; JS adds .is-track). */
[data-component='tabs-architected']
  .tabs-architected_tab-link-underline.is-track {
  transform: none;
  background-color: var(--base--grey-line, #e4e2dd);
  transition: background-color 0.4s ease; /* ease the state-1 ↔ state-2 colour change */
}
/* State 2 — the active tab's track is a bit darker, still 100% wide. */
[data-component='tabs-architected']
  .tabs-architected_tab-link.is-active
  .tabs-architected_tab-link-underline.is-track {
  background-color: var(--tabs-track-active, #b3aea2);
}
/* State 3 — black progress fill (cumulative across tabs; JS scales scaleX 0→1). */
[data-component='tabs-architected'] .tabs-architected_tab-link-fill {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
  background-color: var(--base--black, #000);
}

/* — Reduced motion (no track/fill; keep the active underline full) — */
@media (prefers-reduced-motion: reduce) {
  [data-component='tabs-architected']
    .tabs-architected_tab-link.is-active
    .tabs-architected_tab-link-underline {
    transform: scaleX(1);
  }
}

/* ===== TABS-IMAGING · tabs (no autoplay) — paste into Webflow head ===== */
/* Panel stacking + active-only underline baseline. Hooks → tabs-imaging.md. */

/* Panel stacking (grid: same cell, no CLS) */
[data-component='tabs-imaging'] .tabs-imaging_tabs-content {
  display: grid;
}
[data-component='tabs-imaging'] .tabs-imaging_tab-item {
  grid-area: 1 / 1;
}

/* Image wipe baseline */
[data-component='tabs-imaging'] [tabs-imaging='image'] {
  will-change: clip-path;
}

/* Active-only underline (rail transparent; only the active tab's black fill shows) */
[data-component='tabs-imaging'] .tabs-imaging_tab-link-underline {
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
  background-color: transparent;
}
[data-component='tabs-imaging'] .tabs-imaging_tab-link-underline.is-track {
  transform: none;
}
[data-component='tabs-imaging'] .tabs-imaging_tab-link-fill {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
  background-color: var(--base--black, #000);
}
@media (prefers-reduced-motion: reduce) {
  [data-component='tabs-imaging']
    .tabs-imaging_tab-link.is-active
    .tabs-imaging_tab-link-underline {
    transform: scaleX(1);
    background-color: var(--base--black, #000);
  }
}

/* ===== TABS-FOUNDATION-MODEL · tabs (no autoplay) — paste into Webflow head ===== */
/* Panel stacking + active-only underline baseline. Hooks → tabs-foundation-model.md. */

/* Panel stacking (grid: same cell, no CLS) */
[data-component='tabs-foundation-model'] .tabs-foundation-model_tabs-content {
  display: grid;
}
[data-component='tabs-foundation-model'] .tabs-foundation-model_tab-item {
  grid-area: 1 / 1;
}

/* Image wipe baseline */
[data-component='tabs-foundation-model'] [tabs-foundation-model='image'] {
  will-change: clip-path;
}

/* Active-only underline (rail transparent; only the active tab's black fill shows) */
[data-component='tabs-foundation-model']
  .tabs-foundation-model_tab-link-underline {
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
  background-color: transparent;
}
[data-component='tabs-foundation-model']
  .tabs-foundation-model_tab-link-underline.is-track {
  transform: none;
}
[data-component='tabs-foundation-model'] .tabs-foundation-model_tab-link-fill {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
  background-color: var(--base--black, #000);
}
@media (prefers-reduced-motion: reduce) {
  [data-component='tabs-foundation-model']
    .tabs-foundation-model_tab-link.is-active
    .tabs-foundation-model_tab-link-underline {
    transform: scaleX(1);
